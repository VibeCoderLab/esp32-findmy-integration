@@ -0,0 +1,61 @@
+"""Durable private state writes and fail-closed multi-file ADI persistence."""
+import fcntl
+import os
+from pathlib import Path
+import tempfile
+
+
+def fsync_directory(path):
+    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def atomic_write(path, data):
+    path = Path(path)
+    descriptor, name = tempfile.mkstemp(dir=path.parent, prefix='.state-', suffix='.tmp')
+    try:
+        with os.fdopen(descriptor, 'wb') as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(name, path)
+        fsync_directory(path.parent)
+    finally:
+        Path(name).unlink(missing_ok=True)
+
+
+def lock_state(state):
+    state = Path(state)
+    state.mkdir(parents=True, mode=0o700, exist_ok=True)
+    descriptor = os.open(state / '.machine.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+    lock = os.fdopen(descriptor, 'r+')
+    try:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        if (state / '.store-update.pending').exists():
+            raise RuntimeError('An ADI store update was interrupted. Preserve the whole machine state for review; do not erase the marker or regenerate automatically.')
+    except BaseException:
+        lock.close()
+        raise
+    return lock
+
+
+def save_store(state, files):
+    state = Path(state)
+    output = state / 'store'
+    if output.is_symlink():
+        raise RuntimeError('ADI store must not be a symbolic link.')
+    output.mkdir(mode=0o700, exist_ok=True)
+    if any(not name or Path(name).name != name or name in ('.', '..') for name in files):
+        raise ValueError('Invalid ADI state filename.')
+    pending = state / '.store-update.pending'
+    atomic_write(pending, b'ADI store commit in progress; preserve state if interrupted.\n')
+    # Individual blobs are atomic. The durable marker prevents reuse of a mixed
+    # generation after interruption; never rewind OTP counters automatically.
+    for name, data in files.items():
+        atomic_write(output / name, bytes(data))
+    fsync_directory(output)
+    pending.unlink()
+    fsync_directory(state)
